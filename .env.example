# Safe local-development values only.
# Never put production credentials or API keys here.

POSTGRES_USER=jyotish
POSTGRES_PASSWORD=jyotish
POSTGRES_DB=jyotish

# Used when running the API directly on your computer.
DATABASE_URL=postgresql+psycopg://jyotish:jyotish@localhost:5432/jyotish
REDIS_URL=redis://localhost:6379/0
WEB_URL=http://localhost:3000

# Email (sign-in links, alerts). Mailpit catches everything locally: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# Optional: Google sign-in. Leave empty to hide the Google button.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with redirect URI http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Run background jobs inline instead of in the worker (handy without Docker).
TASKS_EAGER=false

# Production only (the API refuses to start in production with the dev defaults):
# ENVIRONMENT=production
# SECRET_KEY=<64 random characters>
# DATA_ENCRYPTION_KEYS=<Fernet key; comma-separate to rotate, newest first>
# SENTRY_DSN=
